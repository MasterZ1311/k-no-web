# ==============================================================================
# káno̱ Web — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# On Vercel, add these variables in your Project Settings -> Environment Variables.
#
# SECURITY NOTICE:
# - Only public, client-safe configurations (URL and anonymous publishable key)
#   may be configured here.
# - NEVER put Supabase service-role keys, database passwords, or signing secrets
#   into client environment variables.
# ==============================================================================

# Supabase Project Configuration
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
